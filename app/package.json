{
  "name": "vozflow",
  "productName": "VozFlow",
  "version": "0.1.0",
  "description": "Dictado por voz para Windows: texto limpio y prompts estructurados con Groq.",
  "main": "src/main/main.js",
  "author": "Oscar Monroy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vozflow.app",
    "productName": "VozFlow",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "VozFlow",
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
